# Rendered by packaging/build-source.sh: the version, date and bundled-package lines are filled in at build time.
Name:           nopipeline
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Two-way sync between an Obsidian vault and a Notion database

License:        MIT
URL:            https://github.com/agus-enc/nopipeline
Source0:        nopipeline.tar.gz
BuildArch:      noarch

Requires:       nodejs >= 1:22.22
Recommends:     libnotify
Recommends:     xdg-utils
@BUNDLED@

%description
nopipeline keeps an Obsidian vault and a Notion database in sync in both
directions, and keeps the links between notes working.

%prep
%autosetup -n nopipeline-%{version}

%build

%install
install -d %{buildroot}/usr/share/nopipeline %{buildroot}/usr/bin
cp -a src node_modules package.json package-lock.json version.json %{buildroot}/usr/share/nopipeline/
install -m 0755 packaging/nopipeline-launcher.sh %{buildroot}/usr/bin/nopipeline

%files
%license LICENSE node_modules/@notionhq/client/LICENSE node_modules/node-diff3/LICENSE.md
%doc README.md CHANGELOG.md docs/
/usr/bin/nopipeline
/usr/share/nopipeline/

%changelog
* @DATE@ nopipeline <noreply@github.com> - @VERSION@-1
- See CHANGELOG.md
