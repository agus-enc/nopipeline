# Loads the package's repo key into pacman's keyring (pacman-key(8), "Providing a Keyring for Import": --populate reads
# /usr/share/pacman/keyrings/nopipeline.gpg and nopipeline-trusted). The key is what lets pacman check this repository's
# signed packages. If --populate fails (for example pacman's keyring is not initialised), the install still goes on and
# the message says what to run.
#
# Removal does not untrust the key: it stays in pacman's keyring, locally signed and with owner trust 4, like the keys of
# most third-party keyring packages. To drop it, run: pacman-key --delete <fingerprint>

post_install() {
  pacman-key --populate nopipeline ||
    echo "nopipeline: could not load the repo key; run: pacman-key --init && pacman-key --populate nopipeline" >&2
}

post_upgrade() {
  pacman-key --populate nopipeline ||
    echo "nopipeline: could not load the repo key; run: pacman-key --init && pacman-key --populate nopipeline" >&2
}
