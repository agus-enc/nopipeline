<project name="@PROJECT@">
  <title>nopipeline</title>
  <description>Packages of nopipeline for Fedora, Debian, Ubuntu and Arch, built from the signed GitHub release.</description>
  <repository name="Fedora_43">
    <path project="Fedora:43" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>
  <repository name="Fedora_44">
    <path project="Fedora:44" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>
  <repository name="Debian_13">
    <path project="Debian:13" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>
  <repository name="xUbuntu_24.04">
    <path project="Ubuntu:24.04" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>
  <repository name="xUbuntu_26.04">
    <path project="Ubuntu:26.04" repository="standard"/>
    <arch>x86_64</arch>
    <arch>aarch64</arch>
  </repository>
  <repository name="Arch">
    <path project="Arch:Community" repository="standard"/>
    <arch>x86_64</arch>
  </repository>
</project>
